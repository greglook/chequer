#!/usr/bin/env bash
# vim: ft=bash

set -e

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ $1 = lint ]]; then
    clj-kondo --lint src:test

elif [[ $1 = carve ]]; then
    shift
    # NOTE: doesn't run on jolt yet
    exec clj -M:carve --paths src "$@"

else
    # Slow tests tagged ^:load are skipped unless the arguments choose what to include.
    exclude=(-e :load)
    for arg in "$@"; do
      case "$arg" in
        -i|--include|-i*|--include=*) exclude=() ;;
      esac
    done

    exec jolt -M:test -m cognitect.test-runner "${exclude[@]}" "$@"
fi
