#!/usr/bin/env bash
# vim: ft=bash

set -e

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ $1 = clean ]]; then
    rm -rf target

elif [[ $1 = release ]]; then
    shift
    exec jolt -A:release build -m chequer.main -o target/release/chequer "$@"

elif [[ $1 = image ]]; then
    podman build --format docker --tag git.app.gslook.net/greg/chequer:dev .
    if [[ $2 = --push ]]; then
        podman push git.app.gslook.net/greg/chequer:dev
    fi

elif [[ $1 = update-emoji ]]; then
    # Regenerate resources/chequer/emoji.txt from Unicode's emoji-test.txt: the fully-qualified
    # emoji without skin tone variants, as tab-separated emoji and name lines under their
    # group and subgroup headings.
    out="resources/chequer/emoji.txt"
    curl -sSfL "https://www.unicode.org/Public/emoji/latest/emoji-test.txt" | awk '
      /^# (Version|Date):/ { print; next }
      /^# (group|subgroup):/ { print; next }
      /; fully-qualified/ {
        if ($0 ~ /(^| )1F3F[B-F]( |;)/) next
        sub(/^[^#]*# /, "")
        emoji = $1
        sub(/^[^ ]+ E[0-9.]+ /, "")
        print emoji "\t" $0
      }
    ' > "$out"
    echo "Wrote $(grep -vc '^#' "$out") emoji to $out"

else
    echo "Unknown subcommand: $1" >&2
    exit 1
fi
